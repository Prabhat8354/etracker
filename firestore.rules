rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Top-Level Trips:
    function getTripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isTripParticipant(tripId) {
      return request.auth != null && (
        request.auth.uid in getTripData(tripId).participantIds ||
        (getTripData(tripId).keys().hasAny(['memberIds']) && request.auth.uid in getTripData(tripId).memberIds) ||
        getTripData(tripId).createdBy == request.auth.uid
      );
    }

    function isTripOwner(tripId) {
      return request.auth != null && getTripData(tripId).createdBy == request.auth.uid;
    }

    function hasPendingInvitation(tripId) {
      return request.auth != null && (
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/tripInvites/$(tripId)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/tripInvites/$(tripId)).data.status == 'pending'
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/tripInvitations/$(tripId)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/tripInvitations/$(tripId)).data.status == 'pending'
        )
      );
    }

    // -------------------------------------------------------------
    // Top-Level Collaborative Trips: trips/{tripId}
    // -------------------------------------------------------------
    match /trips/{tripId} {
      function docIsParticipant() {
        return request.auth != null && (
          request.auth.uid in resource.data.participantIds ||
          (resource.data.keys().hasAny(['memberIds']) && request.auth.uid in resource.data.memberIds) ||
          resource.data.createdBy == request.auth.uid
        );
      }
      function docIsOwner() {
        return request.auth != null && resource.data.createdBy == request.auth.uid;
      }
      function docIsInvited() {
        return request.auth != null && (
          (resource.data.keys().hasAny(['invitedUserIds']) && request.auth.uid in resource.data.invitedUserIds) ||
          hasPendingInvitation(tripId)
        );
      }

      // Read: only participants, creator, or valid invited users
      allow read: if docIsParticipant() || docIsInvited();

      // Create: authenticated user setting themselves as createdBy & in participantIds
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;

      // Update:
      // 1) Trip owner can update any field
      // 2) Existing participant can update details without altering participantIds
      // 3) An invited user can join by appending ONLY their own UID to participantIds
      // 4) A participant can leave by removing ONLY their own UID from participantIds
      allow update: if request.auth != null && (
        docIsOwner() ||
        (
          docIsParticipant() &&
          request.resource.data.participantIds == resource.data.participantIds
        ) ||
        (
          // Joining: user adds their own UID (with invitation verification)
          (
            docIsInvited() ||
            request.auth.uid in request.resource.data.participantIds
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'memberIds', 'invitedUserIds', 'updatedAt']) &&
          request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
          request.auth.uid in request.resource.data.participantIds
        ) ||
        (
          // Leaving: user removes their own UID
          docIsParticipant() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'memberIds', 'updatedAt']) &&
          resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
          !(request.auth.uid in request.resource.data.participantIds)
        )
      );

      // Delete: only trip owner
      allow delete: if docIsOwner();

      // Subcollection: expenses
      match /expenses/{expenseId} {
        allow read: if isTripParticipant(tripId);

        // Expense creation: caller must be in trip's participantIds,
        // createdBy must be request.auth.uid, and paidBy must belong to trip participantIds
        allow create: if isTripParticipant(tripId) &&
          request.resource.data.createdBy == request.auth.uid &&
          (
            request.resource.data.paidBy in getTripData(tripId).participantIds ||
            (getTripData(tripId).keys().hasAny(['memberIds']) && request.resource.data.paidBy in getTripData(tripId).memberIds)
          );

        // Expense update/delete: caller must be expense creator, expense payer, or trip owner
        allow update, delete: if isTripParticipant(tripId) && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.paidBy == request.auth.uid ||
          isTripOwner(tripId)
        );
      }

      // Subcollection: settlements
      match /settlements/{settlementId} {
        allow read: if isTripParticipant(tripId);

        allow create: if isTripParticipant(tripId) &&
          request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if isTripParticipant(tripId) && (
          resource.data.createdBy == request.auth.uid ||
          isTripOwner(tripId)
        );
      }

      // Subcollection: members cache
      match /members/{memberUid} {
        allow read: if isTripParticipant(tripId) || (request.auth != null && memberUid == request.auth.uid);
        allow write: if request.auth != null && (
          memberUid == request.auth.uid ||
          isTripOwner(tripId)
        );
      }
    }

    // -------------------------------------------------------------
    // User Documents & Personal Finances: users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      // Basic profile: authenticated users can read to find friends by email
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Invitations subcollection: users/{userId}/tripInvites/{inviteId}
      match /tripInvites/{inviteId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          request.resource.data.invitedBy == request.auth.uid &&
          request.resource.data.invitedUserId == userId;
      }

      // Legacy invitation path support: users/{userId}/tripInvitations/{invitationId}
      match /tripInvitations/{invitationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }

      // Personal user transactions: STRICTLY PRIVATE
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Personal user commitments: STRICTLY PRIVATE
      match /commitments/{commitmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Personal user savings: STRICTLY PRIVATE
      match /savings/{savingDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Personal user settings: STRICTLY PRIVATE
      match /settings/{settingDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy user-nested trips fallback
      match /trips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /{subcollection=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Catch-all for personal subcollections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
